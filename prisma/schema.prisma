datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(uuid())
  nisnOrEmail  String       @unique
  password     String
  name         String
  role         String       // "SISWA", "ADMIN_KOMISI_C", "GURU_WAKA"
  targetWaka   String?      // "KEASRAMAAN", "SARPRAS", "AKADEMIK", "HUMAS", "KOPERASI_LA_TAHZAN"
  createdAt    DateTime     @default(now())
  aspirations  Aspiration[] @relation("SiswaAspirations")
}

model Aspiration {
  id              String   @id @default(uuid())
  studentId       String
  student         User     @relation("SiswaAspirations", fields: [studentId], references: [id], onDelete: Cascade)
  content         String
  imageUrl        String?
  target          String   // "KEASRAMAAN", "SARPRAS", "AKADEMIK", "HUMAS", "KOPERASI_LA_TAHZAN"
  status          String   @default("MENUNGGU_KURASI") // "MENUNGGU_KURASI", "DITERUSKAN", "DITOLAK", "SUDAH_DIBACA", "SUDAH_DILAKSANAKAN"
  adminNote       String?
  followUpNote    String?
  followUpImage   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
